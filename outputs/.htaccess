# Clean public page addresses. These are internal rewrites, never redirects.
Options -MultiViews
<IfModule mod_headers.c>
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
RewriteEngine On
# Reject requests for backing HTML files. Internal clean-URL rewrites still work.
# THE_REQUEST is the original browser request, so /kilimanjaro remains a 200.
RewriteCond %{THE_REQUEST} "\s/+[^?\s]*\.html(?:[?\s/])" [NC]
RewriteRule \.html(?:/|$) - [R=404,END,NC]
RewriteRule ^api/booking/(session|send-code|verify-code|logout|profile|quote|create|list|remove|restore|message|confirm|verify-payment|checkout)$ api/booking/index.php [END]

RewriteRule ^api/stripe/(config|request|checkout|status|webhook)$ api/stripe/index.php [END]
RewriteRule ^api/stripe/.*\.php$ - [R=404,END]
RewriteRule ^api/booking/.*\.php$ - [R=404,END]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(about|contact|faq|gear-help|kilimanjaro|safari|volcan-de-fuego|payments|account|privacy-terms)/?$ $1.html [END]
